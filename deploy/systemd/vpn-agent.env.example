# Copy to /etc/cslvpn/vpn-agent.env and chmod 0600.
CSLVPN_SERVER_URL=https://v.csl.by
CSLVPN_PROVISIONER_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CSLVPN_WORKER_ID=vpn-host-01

# These defaults match Ubuntu's dnsmasq package layout.
CSLVPN_DNSMASQ_CONFIG=/etc/dnsmasq.conf
CSLVPN_DHCP_RESERVATIONS_FILE=/etc/dnsmasq.d/cslvpn-reservations.conf
