# Copy to deploy/.env and replace the password before starting.
# The API binds to the VPN server's LAN address so NPM can reach it.
API_BIND_ADDRESS=10.254.100.252
API_PORT=8088

POSTGRES_DB=cslvpn
POSTGRES_USER=cslvpn
# Generate a random hex secret on the Ubuntu host: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_64_HEX_CHAR_SECRET

# Guards the /admin API surface (enrollment codes, device list, revocation).
# Generate a random hex secret on the Ubuntu host: openssl rand -hex 32
ADMIN_API_KEY=REPLACE_WITH_RANDOM_64_HEX_CHAR_SECRET

# Shared secret between SoftEther (hub CSL wildcard "*" user) and the RADIUS
# auth facade built into the API (published on 127.0.0.1:1812/udp only).
# Generate a random hex secret on the Ubuntu host: openssl rand -hex 32
RADIUS_SHARED_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHAR_SECRET
