# Copy to deploy/.env and replace the password before starting.
# The API binds to the VPN server's LAN address so NPM can reach it.
API_BIND_ADDRESS=10.254.100.252
API_PORT=8088

POSTGRES_DB=cslvpn
POSTGRES_USER=cslvpn
# Generate a random hex secret on the Ubuntu host: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_64_HEX_CHAR_SECRET
